{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": true,

      "$connection": {
        ".write": "!data.exists() || !newData.exists()",

        ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()",

        "at": {
          ".validate": "newData.isNumber()"
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}
