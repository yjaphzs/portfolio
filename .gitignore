# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*.local

# Next.js — .next is the build cache, out/ is the static export deployed to Hosting
.next/
out/
# Generated by `next typegen`, which is why `npm run typecheck` runs it first:
# without this file tsc has no declarations for .webp/.jpg/.svg imports, and it
# references .next/types/* which only exists after typegen or a build.
next-env.d.ts
*.tsbuildinfo

# Local environment — never commit. Keep .env.example tracked as the template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase
.firebase/
firebase-debug.log
database-debug.log
ui-debug.log
google-application-credentials.json
